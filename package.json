{
  "name": "chess-tutor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck && tsc -p .claude/hooks --noEmit",
    "spike:engine": "pnpm --filter @chess-tutor/engine spike",
    "demo:bot": "pnpm --filter @chess-tutor/chess-core demo:bot"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
